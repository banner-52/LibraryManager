<views:ThemedWindow x:Class="LibraryManager.Views.WebsiteDetectionWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:LibraryManager.Views" Title="Website detection" Width="920" Height="650" MinWidth="650" MinHeight="500" WindowStartupLocation="CenterOwner">
<Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<StackPanel><TextBlock Text="Find installer links on a website" Style="{DynamicResource SurfaceTitleStyle}"/><TextBlock Text="Software name" Style="{DynamicResource FieldLabelStyle}"/><TextBox x:Name="SoftwareNameTextBox"/><TextBlock Text="Official download page URL" Style="{DynamicResource FieldLabelStyle}"/><TextBox x:Name="PageUrlTextBox"/><WrapPanel Margin="0,8,0,0"><Button Content="Find download links" Click="ScanButton_Click" Style="{DynamicResource PrimaryButtonStyle}" Margin="0,0,8,0"/><Button Content="Cancel scan" Click="CancelScanButton_Click"/></WrapPanel><TextBlock x:Name="StatusTextBlock" Style="{DynamicResource HintTextStyle}" Margin="0,6"/></StackPanel>
<DataGrid x:Name="ResultsDataGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"><DataGrid.Columns><DataGridTextColumn Header="Installer" Binding="{Binding FileName}" Width="160"/><DataGridTextColumn Header="Version" Binding="{Binding DetectedVersion}" Width="90"/><DataGridTextColumn Header="Found in" Binding="{Binding VersionSource}" Width="100"/><DataGridTextColumn Header="Link" Binding="{Binding Url}" Width="*"/><DataGridTextColumn Header="Confidence" Binding="{Binding Confidence}" Width="90"/></DataGrid.Columns></DataGrid>
<StackPanel Grid.Row="2" Margin="0,10,0,0"><TextBlock Text="Direct HTML is scanned first. If needed, Library Manager renders the page with WebView2 and scans the resulting DOM." Style="{DynamicResource HintTextStyle}" TextWrapping="Wrap"/><WrapPanel HorizontalAlignment="Right"><Button Content="Use selected result" Click="UseSelectedButton_Click" Style="{DynamicResource PrimaryButtonStyle}" Margin="0,0,8,0"/><Button Content="Close" IsCancel="True"/></WrapPanel></StackPanel>
</Grid></views:ThemedWindow>
