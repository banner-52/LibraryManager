<UserControl x:Class="LibraryManager.Views.VersionManagerView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel><TextBlock Text="Version Manager" Style="{DynamicResource SurfaceTitleStyle}"/><TextBlock Text="Manage stored package versions and archive contents." Style="{DynamicResource HintTextStyle}"/></StackPanel>
  <DataGrid x:Name="PackagesDataGrid" Grid.Row="1" Margin="0,12" ItemsSource="{Binding Packages}" AutoGenerateColumns="False" CanUserAddRows="False"><DataGrid.Columns><DataGridTextColumn Header="Version" Binding="{Binding Version}" Width="*"/><DataGridTextColumn Header="File" Binding="{Binding FileName}" Width="2*"/><DataGridTextColumn Header="Date" Binding="{Binding Modified}" Width="150"/><DataGridTextColumn Header="Size" Binding="{Binding Size}" Width="100"/></DataGrid.Columns></DataGrid>
  <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="View contents" Click="ViewContentsButton_Click" Style="{DynamicResource StandardButtonStyle}" Margin="0,0,8,0"/><Button Content="Delete selected" Click="DeleteButton_Click" Style="{DynamicResource StandardButtonStyle}"/></StackPanel>
 </Grid>
</UserControl>
