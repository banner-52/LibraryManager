<views:ThemedWindow x:Class="LibraryManager.Views.AutoDetectWizardWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:views="clr-namespace:LibraryManager.Views"
 Title="Auto Detect Wizard" Width="920" Height="690" MinWidth="700" MinHeight="560" WindowStartupLocation="CenterOwner">
 <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
 <Grid Margin="18">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel>
   <TextBlock Text="Auto Detect" Style="{DynamicResource SurfaceTitleStyle}"/>
   <TextBlock Text="Give Library Manager the official website. It will look for the update source, current version and Windows installer, then build reusable detection rules." Style="{DynamicResource HintTextStyle}" TextWrapping="Wrap" Margin="0,4,0,12"/>
   <TextBlock Text="Software name" Style="{DynamicResource FieldLabelStyle}"/><TextBox x:Name="NameTextBox"/>
   <TextBlock Text="Official website or download page" Style="{DynamicResource FieldLabelStyle}"/><TextBox x:Name="UrlTextBox"/>
   <TextBlock Text="Known version (optional)" Style="{DynamicResource FieldLabelStyle}"/><TextBox x:Name="KnownVersionTextBox"/>
   <TextBlock Text="Used only as a hint to identify the version pattern. It will not be stored as a fixed version." Style="{DynamicResource HintTextStyle}"/>
   <WrapPanel Margin="0,10,0,0"><Button x:Name="ScanButton" Content="Start detection" Style="{DynamicResource PrimaryButtonStyle}" Click="ScanButton_Click" Margin="0,0,8,0"/><Button x:Name="CancelScanButton" Content="Cancel" Click="CancelScanButton_Click"/></WrapPanel>
   <ProgressBar x:Name="ProgressBar" Height="5" Margin="0,10,0,0" IsIndeterminate="True" Visibility="Collapsed"/>
   <TextBlock x:Name="StatusTextBlock" Style="{DynamicResource HintTextStyle}" TextWrapping="Wrap" Margin="0,6,0,0"/>
  </StackPanel>
  <Border Grid.Row="1" Margin="0,14,0,0" Padding="14" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
   <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <TextBlock Text="Detection result" Style="{DynamicResource SurfaceTitleStyle}"/>
    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,0"><TextBlock Text="File type" VerticalAlignment="Center" Margin="0,0,8,0"/><ComboBox x:Name="TypeFilter" Width="135" SelectionChanged="Filter_SelectionChanged"><ComboBoxItem Content="All" IsSelected="True"/><ComboBoxItem Content="EXE"/><ComboBoxItem Content="MSI"/><ComboBoxItem Content="MSIX"/><ComboBoxItem Content="ZIP"/><ComboBoxItem Content="7Z"/><ComboBoxItem Content="TAR"/><ComboBoxItem Content="GZ"/><ComboBoxItem Content="DEB"/><ComboBoxItem Content="RPM"/><ComboBoxItem Content="APPIMAGE"/><ComboBoxItem Content="DMG"/><ComboBoxItem Content="PKG"/><ComboBoxItem Content="Other"/><ComboBoxItem Content="Unknown"/></ComboBox><TextBlock Text="Architecture" VerticalAlignment="Center" Margin="14,0,8,0"/><ComboBox x:Name="ArchitectureFilter" Width="130" SelectionChanged="Filter_SelectionChanged"><ComboBoxItem Content="All" IsSelected="True"/><ComboBoxItem Content="x64"/><ComboBoxItem Content="x86"/><ComboBoxItem Content="ARM64"/><ComboBoxItem Content="Unknown"/></ComboBox></StackPanel>
    <ListView x:Name="ResultsList" Grid.Row="2" Height="115" Margin="0,8,0,8" SelectionChanged="ResultsList_SelectionChanged">
     <ListView.View>
      <GridView>
       <GridViewColumn Width="90" DisplayMemberBinding="{Binding Method}"><GridViewColumn.Header><GridViewColumnHeader Tag="Method" Click="ResultsHeader_Click">Method</GridViewColumnHeader></GridViewColumn.Header></GridViewColumn>
       <GridViewColumn Width="65" DisplayMemberBinding="{Binding FileType}"><GridViewColumn.Header><GridViewColumnHeader Tag="FileType" Click="ResultsHeader_Click">File type</GridViewColumnHeader></GridViewColumn.Header></GridViewColumn>
       <GridViewColumn Width="85" DisplayMemberBinding="{Binding Architecture}"><GridViewColumn.Header><GridViewColumnHeader Tag="Architecture" Click="ResultsHeader_Click">Architecture</GridViewColumnHeader></GridViewColumn.Header></GridViewColumn>
       <GridViewColumn Width="85" DisplayMemberBinding="{Binding Version}"><GridViewColumn.Header><GridViewColumnHeader Tag="Version" Click="ResultsHeader_Click">Version ▼</GridViewColumnHeader></GridViewColumn.Header></GridViewColumn>
       <GridViewColumn Width="80" DisplayMemberBinding="{Binding Confidence}"><GridViewColumn.Header><GridViewColumnHeader Tag="Confidence" Click="ResultsHeader_Click">Confidence</GridViewColumnHeader></GridViewColumn.Header></GridViewColumn>
       <GridViewColumn Width="340" DisplayMemberBinding="{Binding Source}"><GridViewColumn.Header><GridViewColumnHeader Tag="Source" Click="ResultsHeader_Click">Download URL</GridViewColumnHeader></GridViewColumn.Header></GridViewColumn>
      </GridView>
     </ListView.View>
    </ListView>
    <Grid Grid.Row="3" Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <StackPanel><TextBlock Text="Method" Style="{DynamicResource FieldLabelStyle}"/><TextBlock Text="Version" Style="{DynamicResource FieldLabelStyle}" Margin="0,10,0,0"/><TextBlock Text="Confidence" Style="{DynamicResource FieldLabelStyle}" Margin="0,10,0,0"/><TextBlock Text="Download URL" Style="{DynamicResource FieldLabelStyle}" Margin="0,10,0,0"/><TextBlock Text="Version regex" Style="{DynamicResource FieldLabelStyle}" Margin="0,10,0,0"/><TextBlock Text="Download regex" Style="{DynamicResource FieldLabelStyle}" Margin="0,10,0,0"/></StackPanel>
     <StackPanel Grid.Column="1"><TextBlock x:Name="MethodText"/><TextBlock x:Name="VersionText" Margin="0,10,0,0"/><TextBlock x:Name="ConfidenceText" Margin="0,10,0,0"/><TextBox x:Name="DownloadUrlText" IsReadOnly="True" Margin="0,6,0,0"/><TextBox x:Name="VersionPatternText" IsReadOnly="True" Margin="0,6,0,0"/><TextBox x:Name="DownloadPatternText" IsReadOnly="True" Margin="0,6,0,0"/></StackPanel>
    </Grid>
   </Grid>
  </Border>
  <StackPanel Grid.Row="2" Margin="0,12,0,0">
   <TextBlock x:Name="SummaryTextBlock" Style="{DynamicResource HintTextStyle}" TextWrapping="Wrap" Margin="0,0,0,8"/>
   <WrapPanel HorizontalAlignment="Right"><Button x:Name="GenerateButton" Content="Generate rule" Click="GenerateButton_Click" IsEnabled="False" Margin="0,0,8,0"/><Button x:Name="ApplyButton" Content="Apply to profile" Style="{DynamicResource PrimaryButtonStyle}" IsEnabled="False" Click="ApplyButton_Click" Margin="0,0,8,0"/><Button Content="Close" IsCancel="True"/></WrapPanel>
  </StackPanel>
 </Grid>
 </ScrollViewer>
</views:ThemedWindow>
