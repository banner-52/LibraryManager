<UserControl x:Class="LibraryManager.Views.Controls.SoftwareTiles"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <ItemsControl ItemsSource="{Binding SoftwareItems}">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Width="220" Height="220" Margin="0,0,10,10" Padding="12"
                            Style="{DynamicResource StandardPanelStyle}" MouseLeftButtonDown="Tile_MouseLeftButtonDown">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="34"/><RowDefinition Height="*"/><RowDefinition Height="38"/></Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="26"/><ColumnDefinition Width="*"/><ColumnDefinition Width="34"/><ColumnDefinition Width="34"/></Grid.ColumnDefinitions>
                                <CheckBox IsChecked="{Binding Selected}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="15"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                <Button Grid.Column="2" ToolTip="Toggle favorite" Tag="{Binding}" Click="FavoriteButton_Click" Style="{DynamicResource StandardButtonStyle}" Width="30" Height="28" Padding="0">
                                    <TextBlock Text="★"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/><Style.Triggers><DataTrigger Binding="{Binding IsFavorite}" Value="True"><Setter Property="Foreground" Value="#FFFFC107"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                                </Button>
                                <Button Grid.Column="3" ToolTip="Toggle update notifications" Tag="{Binding}" Click="NotificationButton_Click" Style="{DynamicResource StandardButtonStyle}" Width="30" Height="28" Padding="0">
                                    <TextBlock Text="🔔"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Opacity" Value="0.35"/><Style.Triggers><DataTrigger Binding="{Binding IsUpdateNotificationEnabled}" Value="True"><Setter Property="Opacity" Value="1"/><Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                                </Button>
                            </Grid>
                            <Grid Grid.Row="1" Margin="0,10,0,8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="72"/></Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Top">
                                    <TextBlock Margin="0,0,0,7"><Run Text="Status: "/><Run Text="{Binding Status}"/></TextBlock>
                                    <TextBlock Margin="0,0,0,7"><Run Text="Version: "/><Run Text="{Binding Local, Mode=OneWay}"/></TextBlock>
                                    <TextBlock Margin="0,0,0,7"><Run Text="Available: "/><Run Text="{Binding Latest, Mode=OneWay}"/></TextBlock>
                                    <TextBlock><Run Text="Method: "/><Run Text="{Binding Source, Mode=OneWay}"/></TextBlock>
                                </StackPanel>
                                <Grid Grid.Column="1">
                                    <Border Width="62" Height="62" Background="{DynamicResource CardBackgroundBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                            CornerRadius="{DynamicResource StandardCornerRadius}"
                                            HorizontalAlignment="Right" VerticalAlignment="Top">
                                        <Image Source="{Binding Icon, Mode=OneWay}" ImageFailed="SoftwareIcon_ImageFailed" Width="50" Height="50" Stretch="Uniform"/>
                                    </Border>
                                    <Ellipse Style="{DynamicResource StatusIndicatorStyle}" HorizontalAlignment="Right"
                                             VerticalAlignment="Top" Margin="0,58,2,0"/>
                                </Grid>
                            </Grid>
                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="42"/><ColumnDefinition Width="8"/><ColumnDefinition Width="42"/><ColumnDefinition Width="8"/><ColumnDefinition Width="42"/></Grid.ColumnDefinitions>
                                <Button Grid.Column="1" Content="↓" ToolTip="Update this software" Tag="{Binding}" Click="UpdateButton_Click" Style="{DynamicResource StandardButtonStyle}" Padding="0" FontSize="18"/>
                                <Button Grid.Column="3" Content="⚙" ToolTip="Configure profile" Tag="{Binding}" Click="ConfigureButton_Click" Style="{DynamicResource StandardButtonStyle}" Padding="0" FontSize="17"/>
                                <Button Grid.Column="5" Content="•••" ToolTip="More actions" Tag="{Binding}" Click="MoreButton_Click" Style="{DynamicResource StandardButtonStyle}" Padding="0"/>
                            </Grid>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </ScrollViewer>
</UserControl>
