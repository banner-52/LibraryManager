<views:ThemedWindow x:Class="LibraryManager.Views.DirectLinkWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:views="clr-namespace:LibraryManager.Views"
 Title="Direct link" Width="620" Height="360" MinWidth="520" WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
 <Grid Margin="20">
  <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel>
   <TextBlock Text="Direct installer link" Style="{DynamicResource SurfaceTitleStyle}"/>
   <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Style="{DynamicResource HintTextStyle}"
              Text="Use this when the installer URL is stable but does not contain a version. Library Manager will use the exact URL for the download."/>
   <TextBlock Text="Installer URL" Style="{DynamicResource FieldLabelStyle}"/>
   <TextBox x:Name="UrlTextBox" TextWrapping="Wrap"/>
   <TextBlock Text="Manual version (optional)" Style="{DynamicResource FieldLabelStyle}"/>
   <TextBox x:Name="VersionTextBox"/>
   <TextBlock Text="Leave empty to use version 1.0." Style="{DynamicResource HintTextStyle}"/>
   <TextBlock x:Name="StatusTextBlock" Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/>
  </StackPanel>
  <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
   <Button Content="Use direct link" Click="UseButton_Click" Style="{DynamicResource PrimaryButtonStyle}" Margin="0,0,8,0"/>
   <Button Content="Cancel" Click="CancelButton_Click" Style="{DynamicResource StandardButtonStyle}"/>
  </StackPanel>
 </Grid>
</views:ThemedWindow>