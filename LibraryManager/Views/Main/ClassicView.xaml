<UserControl x:Class="LibraryManager.Views.Main.ClassicView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="12">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Style="{DynamicResource StandardPanelStyle}" Padding="10">
            <WrapPanel>
                <Button x:Name="CheckButton" Content="Check ▾" Click="CheckButton_Click" Style="{DynamicResource StandardButtonStyle}" Margin="0,0,8,0"/>
                <Button x:Name="UpdateButton" Content="Update ▾" Click="UpdateButton_Click" Style="{DynamicResource PrimaryButtonStyle}" Margin="0,0,8,0"/>
                <Button Content="Add software" Click="AddSoftwareButton_Click" Style="{DynamicResource PrimaryButtonStyle}" Margin="0,0,8,0"/>
                <Button Content="Online catalogue" Click="OnlineCatalogueButton_Click" Style="{DynamicResource StandardButtonStyle}" Margin="0,0,8,0"/>
                <Button Content="Refresh" Click="RefreshButton_Click" Style="{DynamicResource StandardButtonStyle}"/>
            </WrapPanel>
        </Border>
        <Border Grid.Row="1" Style="{DynamicResource StandardPanelStyle}" Padding="10" Margin="0,10">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="170"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <TextBox x:Name="SearchTextBox" Style="{DynamicResource StandardTextBoxStyle}" TextChanged="SearchTextBox_TextChanged"/>
                <ComboBox x:Name="StatusFilterComboBox" Grid.Column="1" Margin="10,0" SelectionChanged="StatusFilterComboBox_SelectionChanged"><ComboBoxItem Content="All statuses" IsSelected="True"/><ComboBoxItem Content="Up to date"/><ComboBoxItem Content="Update available"/><ComboBoxItem Content="Error"/></ComboBox>
                <TextBlock Grid.Column="2" Text="Use the actions at the end of each row for update and configuration"
                           HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}"/>
            </Grid>
        </Border>
        <ContentControl Grid.Row="2" x:Name="SoftwareListContent"/>
        <ContentControl Grid.Row="3" x:Name="ProgressContent" Margin="0,10,0,0"/>
    </Grid>
</UserControl>
