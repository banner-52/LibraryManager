<UserControl x:Class="LibraryManager.Views.Main.ModernView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="Transparent">
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="500"/><ColumnDefinition Width="8"/><ColumnDefinition x:Name="RightPanelColumn" Width="*" MinWidth="390"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Style="{DynamicResource StandardPanelStyle}">
            <Grid Margin="14">
                <Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="42"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="CheckButton" Content="Check ▾" Click="CheckButton_Click" Style="{DynamicResource StandardButtonStyle}" MinWidth="90" Margin="0,0,8,0"/>
                        <Button x:Name="UpdateButton" Content="Update ▾" Click="UpdateButton_Click" Style="{DynamicResource PrimaryButtonStyle}" MinWidth="90" Margin="0,0,8,0"/>
                        <Button x:Name="RefreshButton" Content="Refresh" Style="{DynamicResource StandardButtonStyle}" MinWidth="90" Click="RefreshButton_Click"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="☷" ToolTip="List view" Style="{DynamicResource StandardButtonStyle}" Width="42" Padding="0" FontSize="20" Margin="0,0,6,0" Click="ShowListButton_Click"/>
                        <Button Content="▦" ToolTip="Tiles view" Style="{DynamicResource StandardButtonStyle}" Width="42" Padding="0" FontSize="20" Click="ShowTilesButton_Click"/>
                    </StackPanel>
                </Grid>
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="170"/><ColumnDefinition Width="180"/></Grid.ColumnDefinitions>
                    <TextBox x:Name="SearchTextBox" Grid.Column="0" Style="{DynamicResource StandardTextBoxStyle}" Margin="0,0,8,0" TextChanged="SearchTextBox_TextChanged"/>
                    <ComboBox x:Name="ViewFilterComboBox" Grid.Column="1" Margin="0,0,8,0" SelectionChanged="ViewFilterComboBox_SelectionChanged">
                        <ComboBoxItem Content="Default" IsSelected="True"/>
                        <ComboBoxItem Content="Up to date"/>
                        <ComboBoxItem Content="Update available"/>
                        <Separator/>
                        <ComboBoxItem Content="Method: Website"/>
                        <ComboBoxItem Content="Method: GitHub Releases"/>
                        <ComboBoxItem Content="Method: WinGet"/>
                        <ComboBoxItem Content="Method: Manual"/>
                        <Separator/>
                        <ComboBoxItem Content="Favorites"/>
                        <ComboBoxItem Content="A → Z"/>
                        <ComboBoxItem Content="Z → A"/>
                    </ComboBox>
                    <Border Grid.Column="2" Style="{DynamicResource StandardInfoBoxStyle}">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="{Binding SoftwareCount, StringFormat=Total: {0}}"/>
                            <TextBlock Text="{Binding UpdateAvailableCount, StringFormat=  •  Updates: {0}}"/>
                        </StackPanel>
                    </Border>
                </Grid>
                <ContentControl x:Name="SoftwareContent" Grid.Row="2" Margin="0,10"/>
                <ContentControl x:Name="ProgressContent" Grid.Row="3" Visibility="Collapsed"/>
            </Grid>
        </Border>
        <Button x:Name="ShowPanelButton" Grid.Column="0" Content="Show panel" Style="{DynamicResource StandardButtonStyle}"
                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,20,20,0" Visibility="Collapsed" Click="ShowPanelButton_Click"/>

        <GridSplitter Grid.Column="1" Width="8" Background="Transparent" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" Cursor="SizeWE"/>

        <Border Grid.Column="2" Style="{DynamicResource StandardPanelStyle}">
            <Grid Margin="14">
                <Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="New Profile" Style="{DynamicResource StandardButtonStyle}" MinWidth="110" Margin="0,0,8,0" Click="NewProfileButton_Click"/>
                        <Button Content="Online Catalogue" Style="{DynamicResource StandardButtonStyle}" MinWidth="140" Click="OnlineCatalogueButton_Click"/>
                    </StackPanel>
                    <Button Grid.Column="2" x:Name="HidePanelButton" Content="Hide" Style="{DynamicResource StandardButtonStyle}" MinWidth="80" Click="HidePanelButton_Click"/>
                </Grid>
                <ContentControl x:Name="RightPanelContent" Grid.Row="1" Margin="0,10,0,0">
                    <TextBlock Text="Select a software profile or create a new one." TextAlignment="Center"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}"/>
                </ContentControl>
            </Grid>
        </Border>
    </Grid>
</UserControl>
