<views:ThemedWindow x:Class="LibraryManager.Views.UpdateProgressWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:views="clr-namespace:LibraryManager.Views"
 Title="Update progress" Width="780" Height="540" MinWidth="600" MinHeight="380"
 WindowStartupLocation="CenterOwner">
 <Grid Margin="18">
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="*"/>
   <RowDefinition Height="Auto"/>
  </Grid.RowDefinitions>
  <StackPanel>
   <TextBlock Text="Update progress" Style="{DynamicResource SurfaceTitleStyle}"/>
   <TextBlock Text="Downloads and ZIP creation are completed in local temporary storage before the package is copied to the source folder."
              Style="{DynamicResource HintTextStyle}"/>
  </StackPanel>
  <Border Grid.Row="1" Style="{DynamicResource StandardPanelStyle}" Padding="14" Margin="0,8,0,12">
   <StackPanel>
    <TextBlock Text="{Binding CurrentSoftware, StringFormat=Current software: {0}}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/>
    <TextBlock Text="{Binding Message}" Margin="0,10,0,6" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}"/>
    <Grid>
     <ProgressBar Style="{DynamicResource StandardProgressBarStyle}" Height="24" Value="{Binding Percentage}" IsIndeterminate="{Binding IsIndeterminate}"/>
     <TextBlock Text="{Binding Percentage, StringFormat={}{0}%}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Grid>
   </StackPanel>
  </Border>
  <Border Grid.Row="2" Style="{DynamicResource StandardPanelStyle}" Padding="8">
   <ListBox x:Name="LogListBox" ItemsSource="{Binding LogEntries}" BorderThickness="0" FontFamily="Consolas" FontSize="12"
            ScrollViewer.VerticalScrollBarVisibility="Auto"/>
  </Border>
  <Button x:Name="CancelButton" Grid.Row="3" Content="Cancel" MinWidth="110" HorizontalAlignment="Right"
          Margin="0,14,0,0" IsEnabled="{Binding CanCancel}" Click="CancelButton_Click"/>
 </Grid>
</views:ThemedWindow>
