<views:ThemedWindow x:Class="LibraryManager.Views.GitHubAssetSelectionWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:LibraryManager.Views" Title="Select GitHub asset" Width="620" Height="380" WindowStartupLocation="CenterOwner">
 <Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DataGrid x:Name="AssetsDataGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"><DataGrid.Columns><DataGridTextColumn Header="Filename" Binding="{Binding FileName}" Width="*"/><DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="80"/><DataGridTextColumn Header="Size" Binding="{Binding Size}" Width="90"/></DataGrid.Columns></DataGrid>
  <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0"><Button Content="Use selected" MinWidth="110" Margin="0,0,8,0" Click="UseButton_Click"/><Button Content="Cancel" MinWidth="90" Click="CancelButton_Click"/></StackPanel>
 </Grid>
</views:ThemedWindow>
