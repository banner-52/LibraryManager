<UserControl x:Class="LibraryManager.Views.FirstLaunchGuideView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid Margin="12">
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="*"/>
   <RowDefinition Height="Auto"/>
  </Grid.RowDefinitions>
  <Grid>
   <TextBlock Text="First Launch Guide" Style="{DynamicResource PageTitleStyle}" HorizontalAlignment="Center"/>
  </Grid>
  <Border Grid.Row="1" Style="{DynamicResource StandardPanelStyle}" Padding="18" Margin="0,12,0,0">
   <ScrollViewer x:Name="GuideScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel x:Name="GuideContentPanel" Margin="0,0,12,0"/>
   </ScrollViewer>
  </Border>
  <Grid Grid.Row="2" Margin="0,12,0,0">
   <CheckBox x:Name="DontShowAgainCheckBox" Content="Don't show this again" VerticalAlignment="Center"/>
   <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal">
    <Ellipse x:Name="ProgressDot1" ToolTip="Step 1" Margin="3,0"/>
    <Ellipse x:Name="ProgressDot2" ToolTip="Step 2" Margin="3,0"/>
    <Ellipse x:Name="ProgressDot3" ToolTip="Step 3" Margin="3,0"/>
    <Ellipse x:Name="ProgressDot4" ToolTip="Step 4" Margin="3,0"/>
   </StackPanel>
   <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
    <Button x:Name="BackButton" Content="Back" Click="BackButton_Click" Style="{DynamicResource StandardButtonStyle}" MinWidth="90" Margin="0,0,8,0"/>
    <Button x:Name="NextButton" Content="Next" Click="NextButton_Click" Style="{DynamicResource PrimaryButtonStyle}" MinWidth="90"/>
   </StackPanel>
  </Grid>
  <Grid x:Name="ScreenshotPreviewOverlay" Grid.RowSpan="3" Background="{DynamicResource WindowBackgroundBrush}" Visibility="Collapsed" Panel.ZIndex="10">
   <Border Style="{DynamicResource StandardPanelStyle}" Margin="24" Padding="18">
    <Grid>
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <Grid>
      <TextBlock x:Name="ScreenshotPreviewTitleTextBlock" Style="{DynamicResource FieldLabelStyle}" VerticalAlignment="Center"/>
      <Button Content="Close preview" Click="CloseScreenshotPreview_Click" Style="{DynamicResource StandardButtonStyle}" HorizontalAlignment="Right"/>
     </Grid>
     <Image x:Name="ScreenshotPreviewImage" Grid.Row="1" Margin="0,12,0,0" Stretch="Uniform"/>
    </Grid>
   </Border>
  </Grid>
 </Grid>
</UserControl>
