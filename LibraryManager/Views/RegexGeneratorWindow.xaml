<views:ThemedWindow x:Class="LibraryManager.Views.RegexGeneratorWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:views="clr-namespace:LibraryManager.Views"
 Title="Generate link regex" Width="700" Height="360" MinWidth="600" MinHeight="300"
 WindowStartupLocation="CenterOwner">
 <Grid Margin="20">
  <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel>
   <TextBlock Text="Create a website rule from a download link" Style="{DynamicResource SurfaceTitleStyle}"/>
   <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Style="{DynamicResource HintTextStyle}"
              Text="Paste a known download URL. Select changing text in the URL and mark it as the version or as a variable. You can mark several different variables."/>
   <TextBlock Text="Example download URL" Style="{DynamicResource FieldLabelStyle}"/>
   <TextBox x:Name="SampleUrlTextBox" MinHeight="70" TextWrapping="Wrap" AcceptsReturn="True"/>
   <WrapPanel Margin="0,10,0,0">
    <Button Content="Mark selected version" Click="MarkVersionButton_Click" Style="{DynamicResource StandardButtonStyle}" Margin="0,0,8,0"/>
    <Button Content="Mark selected variable" Click="MarkVariableButton_Click" Style="{DynamicResource StandardButtonStyle}"/>
   </WrapPanel>
   <TextBlock x:Name="StatusTextBlock" Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap" Margin="0,10,0,0"/>
  </StackPanel>
  <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
   <Button Content="Use this regex" Click="UseButton_Click" Style="{DynamicResource PrimaryButtonStyle}" Margin="0,0,8,0"/>
   <Button Content="Cancel" Click="CancelButton_Click" Style="{DynamicResource StandardButtonStyle}"/>
  </StackPanel>
 </Grid>
</views:ThemedWindow>